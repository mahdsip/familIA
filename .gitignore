# ==========================================================================
# familIA — hardened .gitignore for a PUBLIC repository
# Goal: NEVER commit secrets, credentials, Terraform state, or any PII.
# ==========================================================================

# ----- Terraform -----
# State can contain secrets and resource data in plaintext. Never commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Variable files hold real values (account ids, arns, names). Only the
# *.example templates are committed.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Provider plugins, modules cache, lock CLI overrides
.terraform/
.terraform.lock.hcl.local
*.tfplan
*.tfplan.*
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ----- AWS / credentials / secrets -----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
aws.json
.aws/
secrets.*
*secret*
*.secret

# Raspberry Pi client credentials generated by scripts/create_pi_credentials.sh
pi-credentials.env
*-credentials.env

# Local owner mapping — contains real family names. NEVER commit. Only the
# *.example.json template is tracked.
familia.config.json
scripts/familia.config.json

# ----- Lambda build artifacts -----
lambda/**/*.zip
lambda/**/build/
lambda/**/package/
*.zip

# ----- Family documents / any real data (must NEVER be in the repo) -----
# These folders are for local use only if you ever stage docs near the repo.
docs/
documents/
family/
data/
*.pdf
*.docx
*.doc
*.xls
*.xlsx
*.csv
*.jpg
*.jpeg
*.png
*.heic
# Allow diagram/image assets explicitly under assets/ if you add any:
!assets/**/*.png
!assets/**/*.jpg

# ----- Python -----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ----- OS / editor -----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
