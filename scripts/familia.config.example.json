{
  "_comment": "Copy to familia.config.json (gitignored) on the machine that holds your documents. Map each folder alias (as it appears in your directory names) to a display name. Folder matching is case-insensitive and accent-insensitive. NEVER commit the real file to a public repo.",
  "owners": {
    "alice": "Alice Example",
    "bob": "Bob Example",
    "kid1": "Kid One Example",
    "kid2": "Kid Two Example"
  },
  "options": {
    "layout": "auto",
    "default_owner": "shared",
    "default_topic": "general",
    "ignore_folders": ["documents", "docs", "documentos"],
    "allowed_extensions": [
      "pdf", "txt", "md", "csv", "doc", "docx", "xls", "xlsx",
      "ppt", "pptx", "html", "htm", "json", "rtf", "odt",
      "jpg", "jpeg", "png"
    ],
    "exclude_path_patterns": [
      "ihe_pdi", "dicom", "osirix", "weasis", "webexport",
      "expimages", "viewer-windows", "viewer-macosx", ".app", "dicomdir"
    ],
    "enrich_file_metadata": true,
    "media_source": "familia",
    "default_content_type": "document",
    "content_type_map": {}
  }
}
