{
  "_comment": "TEMPLATE ONLY — the names/paths here are generic placeholders. Copy to familia.config.json (gitignored) on the machine that holds your documents and replace them with your real values. Never commit the real file. Owner matching is case-insensitive and accent-insensitive.",
  "owners": {
    "alice": "Alice Example",
    "bob": "Bob Example",
    "kid1": "Kid One Example",
    "kid2": "Kid Two Example"
  },
  "options": {
    "layout": "auto",
    "default_owner": "shared",
    "default_topic": "general",
    "ignore_folders": ["documents", "docs", "documentos"],
    "allowed_extensions": [
      "pdf", "txt", "md", "csv", "doc", "docx", "xls", "xlsx",
      "ppt", "pptx", "html", "htm", "json", "rtf", "odt",
      "jpg", "jpeg", "png"
    ],
    "exclude_path_patterns": [
      "ihe_pdi", "dicom", "osirix", "weasis", "webexport",
      "expimages", "viewer-windows", "viewer-macosx", ".app", "dicomdir"
    ],
    "enrich_file_metadata": true,
    "providers": {
      "documents": "personal_backup",
      "images": "photoprism",
      "movies": "plex",
      "music": "plex"
    }
  }
}
