# systemd unit for the familIA OpenAI-compatible proxy on the OVOS Pi.
#
# Install (on the Pi):
#   1. Copy scripts/ovos_openai_proxy.py and scripts/familia_mcp_bridge.py to
#      /opt/familia/, and create the venv:
#        sudo python3 -m venv /opt/familia/venv
#        sudo /opt/familia/venv/bin/pip install --require-hashes \
#             -r requirements-proxy.txt
#   2. Create /etc/familia/proxy.env from the block below (fill real values).
#      chmod 600 it — it references AWS creds.
#   3. sudo cp this file to /etc/systemd/system/familia-ovos-proxy.service
#      (rename it, dropping ".example")
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now familia-ovos-proxy
#
# /etc/familia/proxy.env  (NOT committed — real values live only on the Pi):
#   FAMILIA_API_URL=https://xxxx.execute-api.eu-central-1.amazonaws.com/prod/ask
#   AWS_REGION=eu-central-1
#   PROXY_API_KEY=familia-local
#   PROXY_HOST=127.0.0.1
#   PROXY_PORT=8080
#   # AWS creds for the familia-pi-client user (from create_pi_credentials.sh):
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   # Optional: live home tools over SSH (stdio MCP, no open ports). Omit to
#   # disable. Key and known_hosts must be readable by the service user.
#   MCP_SERVER_COMMAND=ssh -F none -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/familia/mcp_known_hosts -o ServerAliveInterval=30 -i /etc/familia/mcp_ed25519 familia-mcp@mcpserver.local

[Unit]
Description=familIA OpenAI-compatible proxy (OVOS -> API Gateway /ask, SigV4)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/paths to your Pi. Run as a non-root, unprivileged user.
User=ovos
EnvironmentFile=/etc/familia/proxy.env
ExecStart=/opt/familia/venv/bin/python /opt/familia/ovos_openai_proxy.py
Restart=on-failure
RestartSec=3
# Hardening: loopback-only service, no privilege, no new privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/familia

[Install]
WantedBy=multi-user.target
